        "html": "<script>\n(function(){\n  function esc(s){return s.replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function fmt(){\n    document.querySelectorAll('.rt-preco').forEach(function(w){\n      var el=w.querySelector('p')||w.querySelector('.elementor-widget-container')||w;\n      if(el.dataset.rtOk) return;\n      var t=(el.textContent||'').replace(/\\s+/g,' ').trim();\n      var m=t.match(/^(.*?)((?:USD|US\\$|U\\$|EUR|€|R\\$)\\s*[\\d.,]*\\d)\\s*,?\\s*(.*)$/i);\n      if(!m) return;\n      var de=m[1].trim()||'A partir de'; de=de.charAt(0).toUpperCase()+de.slice(1);\n      el.innerHTML='<span class=\"rt-preco-de\">'+esc(de)+'</span><span class=\"rt-preco-valor\">'+esc(m[2].replace(/^U\\$|^US\\$/i,'USD '))+'</span>'+(m[3]?'<span class=\"rt-preco-comp\">'+esc(m[3])+'</span>':'');\n      el.dataset.rtOk=1;\n    });\n  }\n  if(document.readyState!=='loading') fmt(); else document.addEventListener('DOMContentLoaded',fmt);\n})();\n</script>"
