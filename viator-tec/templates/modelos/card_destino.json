  "custom_css": ".rt-card{overflow:hidden;border-radius:4px;box-shadow:0 2px 10px rgba(0,0,0,.08)}\n.rt-card .rt-card-sub p,.rt-card .rt-card-preco p{margin:0}\n.rt-card .rt-card-preco .elementor-widget-container{font-size:16px}\n.rt-card .rt-card-foto{transition:filter .2s}.rt-card .rt-card-foto:hover{filter:brightness(1.05)}\n/* movimento (24/09). Sem aspas aqui: o CSS do loop item sai inline e o Elementor escapa as aspas */\n.rt-card{position:relative;transition:transform .45s cubic-bezier(.22,.61,.36,1),box-shadow .45s cubic-bezier(.22,.61,.36,1)}\n.rt-card::before{content:counter(rt-linha)!important;font-size:0;line-height:0;color:transparent;overflow:hidden;position:absolute;top:0;left:0;right:0;height:4px;background:#E98300;transform:scaleX(0);transform-origin:0 50%;z-index:3;transition:transform .55s cubic-bezier(.22,.61,.36,1)}\n.rt-card:hover{transform:translateY(-8px);box-shadow:0 18px 40px rgba(0,0,0,.16)}\n.rt-card:hover::before{transform:scaleX(1)}\n.rt-card .rt-card-foto{transform-origin:50% 0;transition:transform .9s cubic-bezier(.22,.61,.36,1)}\n.rt-card:hover .rt-card-foto{transform:scale(1.07)}\n.rt-card > .e-con:not(.rt-card-foto){position:relative;z-index:1}\n.rt-card > .e-con:nth-child(2){background:#F4F4F4}\n.rt-card .elementor-post-title,.rt-card .elementor-heading-title{transition:color .3s}\n.rt-card:hover .elementor-heading-title a{color:#C56F00}\n@media (prefers-reduced-motion:no-preference){@supports (animation-timeline:view()){\n  .vtec-grade-item:has(.rt-card){animation:rt-sobe linear both;animation-timeline:view();animation-range:entry 0% entry 55%}\n}}\n@keyframes rt-sobe{from{opacity:0;transform:translateY(48px)}to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){.rt-card,.rt-card .rt-card-foto,.rt-card::before{transition:none}.rt-card:hover{transform:none}.rt-card:hover .rt-card-foto{transform:none}}"
